# Copier en .env et adapter. Ne jamais versionner le fichier .env.
GPC_DATABASE_URL=postgresql+psycopg://creances:MOT_DE_PASSE@localhost:5432/creances
# Générer avec : python -c "import secrets;print(secrets.token_urlsafe(48))"
GPC_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
GPC_ACCESS_TOKEN_MINUTES=30
GPC_SESSION_IDLE_MINUTES=30
GPC_MAX_FAILED_LOGINS=5
GPC_LOCKOUT_MINUTES=15
GPC_STORAGE_DIR=./storage
GPC_CORS_ORIGINS=http://localhost:5173
GPC_ENVIRONMENT=production
